; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Resistance Permit Denied"
run/main_scene="res://src/game_state/game_root.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

ContentCatalog="*res://src/data/content_catalog.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[input_devices]

joypads/ignore_joypad_on_unfocused_application=true

[shader_globals]

mode_time={
"type": "float",
"value": 0.0
}
actor_rim_color={
"type": "color",
"value": Color(1, 0.94, 0.85, 1)
}
actor_rim_strength={
"type": "float",
"value": 0.5
}
