; Engine configuration file.
; run/main_scene is intentionally unset — /dev-story or the developer sets it
; once a scene exists. An empty project with no main scene opens fine.

config_version=5

[application]

config/name="Resistance Permit Denied"
config/features=PackedStringArray("4.7", "Forward Plus")

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[rendering]

renderer/rendering_method="forward_plus"
