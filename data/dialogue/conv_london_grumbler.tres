[sub_resource type="Resource" id="l_1"]
script = ExtResource("2_line")
speaker = "Retired accountant"
text = "No invoices, no late fees. How is anyone supposed to know what they owe?"

[sub_resource type="Resource" id="l_2"]
script = ExtResource("2_line")
speaker = "Baguette Thrower"
speaker_id = "char_baguette_thrower"
text = "You owe the Baguette Thrower one thank-you. Payable now, in full. The crowd goes wild!"

[sub_resource type="Resource" id="l_3"]
script = ExtResource("2_line")
speaker = "Retired accountant"
text = "Will you be sending a receipt?"

[resource]
