[gd_resource type="Resource" script_class="Conversation" load_steps=9 format=3]

[ext_resource type="Script" path="res://src/dialogue/conversation.gd" id="1_conv"]
[ext_resource type="Script" path="res://src/dialogue/dialogue_line.gd" id="2_line"]

[sub_resource type="Resource" id="l_1"]
script = ExtResource("2_line")
text = "Some bosses finished, some let go. The street isn't sure about the squad. Neither are the aliens."

[sub_resource type="Resource" id="l_2"]
script = ExtResource("2_line")
speaker = "Encrypted message"
text = "Squad. Your record is... inconclusive. The alliance has scheduled a review."

[sub_resource type="Resource" id="l_3"]
script = ExtResource("2_line")
speaker = "Florida Man"
speaker_id = "char_florida_man"
text = "Inconclusive is my middle name. Also my entire legal defence."

[sub_resource type="Resource" id="l_4"]
script = ExtResource("2_line")
text = "The occupation thins out. Some aliens stay to run the trains. Some humans stay underground to complain about it."

[sub_resource type="Resource" id="l_5"]
script = ExtResource("2_line")
speaker = "Karen"
speaker_id = "char_karen"
text = "A review. Of us. I want the review's manager."

[sub_resource type="Resource" id="l_6"]
script = ExtResource("2_line")
text = "It isn't peace and it isn't war. It's a very long queue. Earth has survived worse."

[resource]
script = ExtResource("1_conv")
id = "conv_ending_split"
lines = Array[ExtResource("2_line")]([SubResource("l_1"), SubResource("l_2"), SubResource("l_3"), SubResource("l_4"), SubResource("l_5"), SubResource("l_6")])
