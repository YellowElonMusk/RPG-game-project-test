[gd_resource type="Resource" script_class="MapData" load_steps=5 format=3]

[ext_resource type="Script" path="res://src/data/records/map_data.gd" id="1_a"]
[ext_resource type="Script" path="res://src/data/records/critical_path_leg.gd" id="2_leg"]

[sub_resource type="Resource" id="leg_1"]
script = ExtResource("2_leg")
id = "town_out"
from_entry = &"from_segment"
to = "exit_to_segment"

[sub_resource type="Resource" id="leg_2"]
script = ExtResource("2_leg")
id = "town_home"
from_entry = &"from_segment"
to = "camp_cafe"

[resource]
script = ExtResource("1_a")
id = "map_paris_town_placeholder"
display_name = "Paris - Town"
faction_id = "faction_bureaucratia"
base_stage = 1
critical_path = Array[ExtResource("2_leg")]([SubResource("leg_1"), SubResource("leg_2")])
region_liberation_flag = "paris_liberated"
liberated_profile_id = "overworld_liberated"
liberated_kit_id = "kit_paris_liberated"
new_game_entry = true
