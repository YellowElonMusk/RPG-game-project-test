[gd_resource type="Resource" script_class="ChapterSteps" load_steps=10 format=3]

[ext_resource type="Script" path="res://src/chapters/chapter_steps.gd" id="1_steps"]
[ext_resource type="Script" path="res://src/chapters/chapter_step.gd" id="2_step"]

[sub_resource type="Resource" id="step_1"]
script = ExtResource("2_step")
id = "london_step_leave_town"
objective = "Head out of the City toward MegaCorp Tower."
map_id = "map_london_town_placeholder"
leg_id = "town_out"
flags_on_enter = PackedStringArray("london_billing_live")

[sub_resource type="Resource" id="step_2"]
script = ExtResource("2_step")
id = "london_step_reach_prefecture"
objective = "Get down Cheapside to MegaCorp Tower."
map_id = "map_london_segment_placeholder"
leg_id = "segment_to_dungeon"

[sub_resource type="Resource" id="step_3"]
script = ExtResource("2_step")
id = "london_step_take_a_number"
objective = "Get past Reception."
map_id = "map_london_dungeon_placeholder"
leg_id = "dungeon_to_counter"

[sub_resource type="Resource" id="step_4"]
script = ExtResource("2_step")
id = "london_step_find_supervisor"
objective = "Find the CEO."
map_id = "map_london_dungeon_placeholder"
leg_id = "dungeon_to_boss"

[sub_resource type="Resource" id="step_5"]
script = ExtResource("2_step")
id = "london_step_defeat_supervisor"
objective = "Defeat the CEO."
map_id = "map_london_boss_chamber_placeholder"
leg_id = "boss_fight"

[sub_resource type="Resource" id="step_6"]
script = ExtResource("2_step")
id = "london_step_walk_home_a"
objective = "Walk back through the unsubscribed streets."
map_id = "map_london_segment_placeholder"
leg_id = "segment_home"

[sub_resource type="Resource" id="step_7"]
script = ExtResource("2_step")
id = "london_step_walk_home_b"
objective = "Back to the café."
map_id = "map_london_town_placeholder"
leg_id = "town_home"

[resource]
script = ExtResource("1_steps")
chapter_id = "chapter_london"
last_act_from = "london_step_walk_home_a"
last_act_entry_id = &"from_dungeon"
steps = Array[ExtResource("2_step")]([SubResource("step_1"), SubResource("step_2"), SubResource("step_3"), SubResource("step_4"), SubResource("step_5"), SubResource("step_6"), SubResource("step_7")])
