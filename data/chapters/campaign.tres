[gd_resource type="Resource" script_class="Campaign" load_steps=11 format=3]

[ext_resource type="Script" path="res://src/chapters/campaign.gd" id="1_camp"]
[ext_resource type="Script" path="res://src/chapters/campaign_chapter.gd" id="2_ch"]
[ext_resource type="Resource" path="res://data/chapters/chapter_paris_steps.tres" id="3_ps"]
[ext_resource type="Resource" path="res://data/chapters/chapter_paris_flags.tres" id="4_pf"]
[ext_resource type="Resource" path="res://data/chapters/chapter_london_steps.tres" id="5_ls"]
[ext_resource type="Resource" path="res://data/chapters/chapter_london_flags.tres" id="6_lf"]
[ext_resource type="Resource" path="res://data/chapters/chapter_sydney_steps.tres" id="7_ss"]
[ext_resource type="Resource" path="res://data/chapters/chapter_sydney_flags.tres" id="8_sf"]

[sub_resource type="Resource" id="ch_paris"]
script = ExtResource("2_ch")
steps = ExtResource("3_ps")
flags = ExtResource("4_pf")
start_camp_id = "camp_paris_cafe"

[sub_resource type="Resource" id="ch_london"]
script = ExtResource("2_ch")
steps = ExtResource("5_ls")
flags = ExtResource("6_lf")
start_entry_id = &"from_arrival"
start_camp_id = "camp_london_cafe"
intro_line = "London. MegaCorp got here first and sold it back to everyone, monthly. Every round of every fight is billed. Spend your MP before they take it."

[sub_resource type="Resource" id="ch_sydney"]
script = ExtResource("2_ch")
steps = ExtResource("7_ss")
flags = ExtResource("8_sf")
start_entry_id = &"from_arrival"
start_camp_id = "camp_sydney_cafe"
intro_line = "Sydney. Influencia turned the whole harbour into content. Every hit you land gets them attention, and attention makes them stronger. Pick one and finish it."
end_line = "Sydney is unfollowed. Somewhere out there, one more alien world has opinions about Earth. To be continued."

[resource]
script = ExtResource("1_camp")
chapters = Array[ExtResource("2_ch")]([SubResource("ch_paris"), SubResource("ch_london"), SubResource("ch_sydney")])
