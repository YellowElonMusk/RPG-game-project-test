"permit_rounds": 3,
"low_hp_threshold": 0.5,
"hunker_jab_move": "move_pen_jab",
"focus_attack_move": "move_red_tape",
"late_fee_move": "move_late_fee",
"mass_audit_move": "move_mass_audit",
"final_notice_move": "move_final_notice"
}
texts = Dictionary[String, String]({
"banner_locked_one": "BUREAUCRATIA — Special moves need a government permit. It arrives in {rounds_left} round. Attack and Defend only, for both sides.",
"banner_locked_other": "BUREAUCRATIA — Special moves need a government permit. It arrives in {rounds_left} rounds. Attack and Defend only, for both sides.",
"banner_unlocked": "PERMIT GRANTED — All-out war! Special moves are allowed for both sides.",
"tooltip_locked": "Bureaucratia requires a government permit before anyone can use a Special move. Attack and Defend only until it arrives.",
"tooltip_unlocked": "The permit arrived: Special moves are now allowed for both sides."
})
colors = Dictionary[String, String]({
"banner_unlocked": "#b07a12"
})
