[ext_resource type="Script" path="res://src/data/records/faction_rule_data.gd" id="1_a"]

[resource]
script = ExtResource("1_a")
id = "rule_bureaucratia_permit"
rule_class = &"bureaucratia_permit"
ref_ids = PackedStringArray("move_pen_jab", "move_red_tape", "move_late_fee", "move_mass_audit", "move_final_notice", "enemy_clerk", "enemy_supervisor")
